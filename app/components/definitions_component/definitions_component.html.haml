.definitions-component{id: @id}
  %ul.definitions-list{role: 'list'}
    - items.each do |item|
      %li
        - if link?(item[:text])
          .definition-node
            = definition_uri(item)
            = language_tag(item)
        - else
          %p.definition-text{lang: item[:lang]}
            = item[:text]
            = language_tag(item)
            = raw_data_link(item)
