- created_at = agent_created_at(agent)
- username = agent_creator_username(agent)
%span.d-none= agent_created_sort_key(agent)
.d-flex.flex-column.text-nowrap
  - if created_at
    %span{ title: created_at.strftime('%Y-%m-%d %H:%M:%S %z'), data: { controller: 'tooltip' } }
      = l(created_at.to_date, format: :month_day_year)
  - else
    %span.text-muted.font-italic= t('agents.index.date_unknown')
  - if username
    %span.text-muted.small= t('agents.index.added_by', user: username)
