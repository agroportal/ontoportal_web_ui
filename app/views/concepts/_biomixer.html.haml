= render_in_modal do
  -# The OntoPortal BioMixer Visualizer, embedded in an iframe. Two hosts, and a
  -# vendored build each (see visualizer_embed_url):
  -#
  -#   :tab   — the narrow Visualization tab, on the canvas-first build. Its
  -#            fullscreen button clears the page around it by posting
  -#            `biomixer_full_screen_request` (see visualizer_expand_controller),
  -#            so the Fullscreen API is withheld to keep the two from both firing.
  -#   :modal — the larger view, on the classic build, with room for its flat
  -#            layout and for the Fullscreen API the visualizer drives itself.
  - variant = local_assigns.fetch(:variant, :modal)
  .visualizer-embed
    %iframe{src: visualizer_embed_url(@ontology, @concept, variant: variant),
            title: t('concepts.visualization'),
            allow: ('fullscreen' if variant == :modal), allowfullscreen: variant == :modal,
            frameborder: 0, width: '100%', height: '100%'}
