= render TurboFrameComponent.new(id: 'concept_show') do
  - if @concept.id.eql?("bp_fake_root")
    = render Display::AlertComponent.new do
      = t('concepts.use_jump_to')
  - else
    %div{'data-controller': 'concepts-json', 'data-action': 'click->concepts-json#update'}
      = ontology_object_tabs_component(ontology_id: @ontology.acronym, objects_title: "classes", object_id: @concept.id) do |c|
        - baseClassUrl = "#{@ontology.id}/classes/#{escape(@concept.id)}"
        - detail_link = api_button_link_and_target("#{baseClassUrl}?display=all")[0]
        - tab_item_component(container_tabs: c, title: t('concepts.details'), path: '#details', selected: true, json_link: detail_link) do
          = render :partial =>'/concepts/details'

        - unless skos?
          - count_span = content_tag(:span, "#{t('concepts.instances')} (#{content_tag(:span, "", id: 'concept_instances_sorted_list_count')})".html_safe)
          - instance_link = api_button_link_and_target("#{baseClassUrl}/instances")[0]
          - tab_item_component(container_tabs: c, title: count_span, path: '#instances', json_link: instance_link) do
            = render :partial =>'instances/instances' , locals: {id: "class-instances-data-table"}


        - tab_item_component(container_tabs: c, title: t('concepts.visualization'), path: '#visualization') do
          -# The class tree takes a third of the page, so the tab column leaves the
          -# visualizer's own chrome (view tabs, search, side panels) little room for
          -# the graph itself. Offer the same embed in a near-viewport modal.
          .d-flex.justify-content-end.mb-2
            = link_to_modal(nil, "/ajax/biomixer?ontology=#{@ontology.acronym}&conceptid=#{CGI.escape(@concept.id)}",
              { class: 'btn btn-sm btn-outline-primary',
              data: { show_modal_title_value: t('concepts.visualization'), show_modal_size_value: 'modal-graph' } }) do
              %i.fas.fa-expand.mr-1
              = t('concepts.visualization_expand')
          -# visualizer-embed condenses the visualizer's chrome into one bar and two
          -# edge drawers so the pane goes to the graph; the modal above keeps the
          -# full layout. On the wrapper, not in the partial, which the modal shares.
          %div{data: {controller: 'visualizer-embed'}}
            = render :partial =>'/concepts/biomixer'

        -# Graph: a node-link diagram of the class's is-a ancestors and asserted
        -# relationships. loading:'lazy' so the (expensive, many-API-call) graph build
        -# only runs when this tab is actually shown — not on every class select while
        -# you're on Details. The pane needs its `id` so the stylesheet can give the
        -# absolutely-positioned canvas a height (see entity_graph.scss).
        - tab_item_component(container_tabs: c, id: 'concept-graph', title: t('concepts.entity_graph'), path: '#graph') do
          -# Pass the active language so the graph's labels (and its cache key) match
          -# the class page's language on multilingual ontologies.
          = render TurboFrameComponent.new(id: 'concept_entity_graph', loading: 'lazy',
          src: "/ajax/entity_graph?ontologyid=#{@ontology.acronym}&conceptid=#{CGI.escape(@concept.id)}&language=#{CGI.escape(request_lang.to_s)}")

        -# Playground: the same neighbourhood rendered by the vendored Ontology
        -# Playground viewer, which also serves it back as RDF/XML. Lazy for the same
        -# reason as the Graph tab, and because its script is 780 KB.
        - tab_item_component(container_tabs: c, id: 'concept-playground', title: t('concepts.playground'), path: '#playground') do
          = render TurboFrameComponent.new(id: 'concept_ontology_playground', loading: 'lazy',
          src: "/ajax/ontology_playground?ontologyid=#{@ontology.acronym}&conceptid=#{CGI.escape(@concept.id)}&language=#{CGI.escape(request_lang.to_s)}")


        - count_span = content_tag(:span, "#{t('concepts.notes')} (#{content_tag(:span, @notes.length, id: 'note_count')})".html_safe)
        - notes_link = api_button_link_and_target("#{baseClassUrl}/notes")[0]
        - tab_item_component(container_tabs: c, title: count_span, path: '#notes', json_link: notes_link) do
          = render :partial =>'/notes/list'


        - count_span = content_tag(:span, "#{t('concepts.mappings')} (#{content_tag(:span, concept_mappings_loader(ontology_acronym: @ontology.acronym, concept_id: @concept.id))})".html_safe, class: "d-flex")
        - mappings_link = api_button_link_and_target("#{baseClassUrl}/mappings")[0]
        - tab_item_component(container_tabs: c, title: count_span, path: '#mappings', json_link: mappings_link) do
          = render TurboFrameComponent.new(id:'concept_mappings',
          src:"/ajax/mappings/get_concept_table?ontologyid=#{@ontology.acronym}&conceptid=#{CGI.escape(@concept.id)}")


    :javascript
      jQuery(document).ready(function(){
        jQuery("#classPermalinkModal").on("shown.bs.modal", function (e) {
        var currentPurl = jQuery("a.class-permalink").data("current-purl");
        jQuery("#purl_input").val(currentPurl);
        })

        jQuery("#purl_input").on("click", function () {
        jQuery(this).select();
        });
      });
