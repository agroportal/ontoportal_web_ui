= turbo_frame_tag 'visualization' do
  - if vowl_ready?(@submission_latest)
    #webvowl_container{ style: "position: relative; width: 100%; height: 80vh;" }
      #webvowl_loading.d-flex.flex-column.align-items-center.justify-content-center{ style: "position: absolute; inset: 0; background: #fff; z-index: 1;" }
        .p-3
          = render LoaderComponent.new(type: 'pulsing')
      %iframe#webvowl_frame{ src: "#{LinkedData::Client.settings.rest_url.to_s.chomp('/')}/webvowl/index.html#ontology",
                             data: { json: "/ontologies/#{@ontology.acronym}/vowl/data/ontology.json" },
                             style: "width: 100%; height: 100%; border: none;",
                             title: t('submissions.vowl') }
    %template#webvowl_failure
      = empty_state(text: t('ontologies.sections.visualization_load_failed'))
    :javascript
      (function () {
        var frame = document.getElementById('webvowl_frame');
        var overlay = document.getElementById('webvowl_loading');
        var frameOrigin = new URL(frame.src).origin;

        function fetchJson() {
          return fetch(frame.dataset.json, { credentials: 'same-origin' }).then(function (response) {
            return response.ok ? response.arrayBuffer() : null;
          }).catch(function () {
            return null;
          });
        }

        function showFailure() {
          var failure = document.getElementById('webvowl_failure');
          document.getElementById('webvowl_container').replaceWith(failure.content.cloneNode(true));
          window.removeEventListener('message', onMessage);
        }

        var prefetched = fetchJson();
        var servedDocument = null;

        function ping() {
          try { frame.contentWindow.postMessage({ type: 'vowl-ping' }, frameOrigin); } catch (e) {}
        }

        function removeOverlay() {
          if (overlay) { overlay.remove(); overlay = null; }
        }

        function onMessage(event) {
          if (!document.body.contains(frame)) {
            window.removeEventListener('message', onMessage);
            return;
          }
          if (event.origin !== frameOrigin || event.source !== frame.contentWindow || !event.data) return;
          if (event.data.type === 'vowl-ready') {
            if (event.data.id === servedDocument) return;
            servedDocument = event.data.id;
            var json = prefetched || fetchJson();
            prefetched = null;
            json.then(function (buffer) {
              if (!buffer) return showFailure();
              frame.contentWindow.postMessage({ type: 'vowl-json', buffer: buffer }, frameOrigin, [buffer]);
            });
          } else if (event.data.type === 'vowl-drawn') {
            removeOverlay();
          }
        }

        window.addEventListener('message', onMessage);
        frame.addEventListener('load', ping);
        ping();
        setTimeout(removeOverlay, 180000);
      })();
  - else
    #visualization_content{ style: "padding: 1em;" }
      %p= t('ontologies.sections.visualization_unavailable')
