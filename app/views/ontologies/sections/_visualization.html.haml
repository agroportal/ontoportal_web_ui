= turbo_frame_tag 'visualization' do
  - if vowl_ready?(@submission_latest)
    #webvowl_container{ style: "position: relative; width: 100%; height: 80vh;" }
      #webvowl_loading.d-flex.flex-column.align-items-center.justify-content-center{ style: "position: absolute; inset: 0; background: #fff; z-index: 1;" }
        .p-3
          = render LoaderComponent.new(type: 'pulsing')
      %iframe#webvowl_frame{ src: "/ontologies/#{@ontology.acronym}/vowl/",
                             style: "width: 100%; height: 100%; border: none;",
                             title: t('submissions.vowl') }
    :javascript
      (function () {
        var started = Date.now();
        var timer = setInterval(function () {
          // Looked up on every tick: Turbo can replace these nodes after the
          // script has run, and a captured reference would point at the old one.
          var frame = document.getElementById('webvowl_frame');
          var overlay = document.getElementById('webvowl_loading');
          if (!frame || !overlay) return;

          var drawn = 0;
          try {
            drawn = frame.contentDocument.querySelectorAll('svg .node, svg circle').length;
          } catch (e) { drawn = 0; }

          if (drawn > 0 || Date.now() - started > 180000) {
            // Removed rather than hidden: the Bootstrap utility class on it
            // carries display: flex !important, which an inline style loses to.
            overlay.remove();
            clearInterval(timer);
          }
        }, 500);
      })();
  - else
    #visualization_content{ style: "padding: 1em;" }
      %p= t('ontologies.sections.visualization_unavailable')
