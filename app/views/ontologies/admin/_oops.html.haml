= turbo_frame_tag 'oops' do
  - service_link, target = api_button_link_and_target(oops_report_url(@ontology.acronym)) if @oops.present?
  = render SummarySectionComponent.new(title: t('ontologies.admin.oops.title'), service_link: service_link, target: target) do
    .p-3
      - if @oops.blank?
        %p.text-muted= t('ontologies.admin.oops.unavailable')
      - else
        %p.text-muted
          = t('ontologies.admin.oops.summary', total: @oops['total_pitfalls'], critical: @oops['total_critical'], important: @oops['total_important'], minor: @oops['total_minor'])
        %table.table.table-sm
          %thead
            %tr
              %th= t('ontologies.admin.oops.code')
              %th= t('ontologies.admin.oops.pitfall')
              %th= t('ontologies.admin.oops.importance')
              %th= t('ontologies.admin.oops.affected')
          %tbody
            - @oops['pitfalls'].each do |pitfall|
              %tr
                %td= pitfall['code']
                %td
                  = pitfall['name']
                  %br
                  %small.text-muted= pitfall['description']
                %td
                  %span.badge.badge-pill.text-white{class: oops_importance_class(pitfall['importance'])}= pitfall['importance']
                %td= pitfall['affected_elements_total']
