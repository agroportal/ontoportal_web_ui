= turbo_frame_tag "admin_log_frame" do
  -# A log without errors says so instead of listing its lines; Download has them
  - if @log.blank?
    %p= t('ontologies.admin.log.no_log')
  - elsif @log.is_a?(Array) && @log.none? { |entry| entry.to_h[:severity] == 'ERROR' }
    %p= t('ontologies.admin.log.no_errors', acronym: @ontology.acronym)
  - else
    %div
      - begin
        - logs = @log.is_a?(String) ? JSON.parse(@log) : @log
        - logs = [logs] unless logs.is_a?(Array)
        - logs.each do |entry|
          - entry = entry.to_h
          - if entry.is_a?(Hash)
            - severity_class = case entry[:severity]
              - when 'ERROR' then 'text-danger'
              - when 'DEBUG' then 'text-warning'
              - when 'INFO' then 'text-success'
              - else ''
            = safe_join(["[#{entry[:timestamp]}] ", content_tag(:span, "#{entry[:severity]}:", class: severity_class), " #{entry[:message]}"])
          - else
            = entry.to_s
      - rescue => e
        - if @log.is_a?(String)
          - @log.split("\n").each do |line|
            %div= line
        - else
          %div= @log.to_s
          %div.text-danger= t('ontologies.admin.log.parse_error', message: e.message)
