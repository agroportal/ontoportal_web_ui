= turbo_frame_tag 'ontology-administration-tab' do
  - report = @ontologies_report || {}
  - ontologies = report[:ontologies] || {}
  - hide = %i[format administeredBy date_created report_date_updated errErrorStatus errMissingStatus problem logFilePath]
  %div{ data: { controller: 'admin-ontologies',
                'admin-ontologies-process-url-value': '/admin/ontologies',
                'alert-choose': t('admin.ontologies.alert_choose'),
                'alert-select': t('admin.ontologies.alert_select') } }
    #admin_ontologies_messages
      - if report[:errors].present?
        = render Display::AlertComponent.new(message: report[:errors], type: 'danger', closable: true)
    .d-flex.align-items-center.flex-wrap.mb-2
      %span= t('admin.index.report_generated_on')
      %span.mx-2.fw-bold.report_date_generated= report[:report_date_generated].presence || t('admin.ontologies.generate')
      = button_to t('admin.ontologies.refresh'), '/admin/refresh_ontologies_report', method: :post, form: { data: { turbo: true, turbo_frame: 'ontology-administration-tab' } }, class: 'btn btn-sm btn-outline-primary ms-2'
    .d-flex.align-items-center.flex-wrap.mb-3
      %span.me-2= t('admin.ontologies.view_ontologies')
      %a.me-3{ href: '#', data: { action: 'admin-ontologies#showAll' } }= t('admin.ontologies.all')
      %a.me-4{ href: '#', data: { action: 'admin-ontologies#showProblemOnly' } }= t('admin.ontologies.problem_only')
      %span.me-2= t('admin.ontologies.apply_to_selected')
      %select.form-select.form-select-sm.w-auto.me-2{ data: { 'admin-ontologies-target': 'action' } }
        %option{ value: '' }= t('admin.ontologies.please_select')
        %option{ value: 'delete' }= t('admin.ontologies.act_delete')
        %option{ value: 'all' }= t('admin.ontologies.act_process')
        %option{ value: 'process_annotator' }= t('admin.ontologies.act_annotate')
        %option{ value: 'diff' }= t('admin.ontologies.act_diff')
        %option{ value: 'index_search' }= t('admin.ontologies.act_index')
        %option{ value: 'run_metrics' }= t('admin.ontologies.act_metrics')
        %option{ value: 'generate_oops' } OOPS
      %button.btn.btn-sm.btn-primary{ data: { action: 'admin-ontologies#performAction' } }= t('admin.ontologies.go')
    = render TableComponent.new(id: 'adminOntologies', stripped: true, searching: true, paging: true, ordering: true, no_init_sort: true, search_placeholder: t('admin.ontologies.filter')) do |tbl|
      - tbl.with_header do |h|
        - h.th { check_box_tag('select_all', '1', false, data: { action: 'admin-ontologies#toggleAll' }) }
        - h.th { t('admin.ontologies.col_ontology') }
        - h.th { t('admin.ontologies.col_admin') }
        - h.th { t('admin.ontologies.col_format') }
        - h.th { t('admin.ontologies.col_date_created') }
        - h.th { t('admin.ontologies.col_report_date') }
        - h.th { t('admin.ontologies.col_url') }
        - h.th { t('admin.ontologies.col_error_status') }
        - h.th { t('admin.ontologies.col_missing_status') }
        - h.th { t('admin.ontologies.col_issues') }
      - ontologies.each do |acronym, o|
        - acr = acronym.to_s
        - tbl.with_row(id: "tr_#{acr}", class_css: (o[:problem] ? 'problem' : '')) do |r|
          - r.td { check_box_tag('ontology_ids[]', acr, false, id: nil, data: { 'admin-ontologies-target': 'checkbox' }) }
          - r.td { link_to(acr, "/ontologies/#{acr}", target: '_blank', style: (o[:problem] ? 'color:red;' : '')) }
          - r.td { Array(o[:administeredBy]).join('<br>').html_safe }
          - r.td { o[:format] }
          - r.td { o[:date_created] }
          - r.td { o[:report_date_updated] }
          - r.td do
            - if o[:logFilePath].present?
              = link_to t('admin.ontologies.link_log'), "/admin/ontologies/#{acr}/log", target: '_blank'
            = link_to t('admin.ontologies.link_rest'), "#{$REST_URL}/ontologies/#{acr}", target: '_blank'
            = link_to t('admin.ontologies.link_submissions'), "/ontologies/#{acr}/submissions?container_id=application_modal_content", data: { controller: 'show-modal', 'show-modal-title-value': t('admin.ontologies.submissions_modal_title', acronym: acr), action: 'click->show-modal#show', turbo: 'true', 'turbo-frame': 'application_modal_content' }
          - r.td { Array(o[:errErrorStatus]).join(', ').html_safe }
          - r.td { Array(o[:errMissingStatus]).join(', ').html_safe }
          - r.td { o.reject { |k, _| hide.include?(k) }.values.join('<br>').html_safe }
