= render_in_modal do
  - is_federated = @key.to_s == "federated_portals"

  - if is_federated && !@federation_allowed
    = render Display::AlertComponent.new(type: 'warning', closable: false, message: t('admin.catalog_configuration.federation_not_allowed'))
    %div.mt-2{style: 'display: flex; justify-content: flex-end;'}
      %button.btn.btn-secondary{ type: "button", "data-action": "turbo-modal#hide" }
        = "Close"
  - else
    - if is_federated
      = render Display::AlertComponent.new(type: 'info', closable: false, message: t('admin.catalog_configuration.federation_provide_apikey'))

    = form_with url: admin_catalog_configuration_path, method: :patch, local: false, turbo: true do |f|
      = hidden_field_tag "config[#{@key}][]", "", id: "empty_config_#{@key}"
      = render NestedFormInputsComponent.new(object_name: "portal", show_add_button: !is_federated) do |c|
        - c.header do
          - header_content = @field_names.map { |field_name| content_tag(:div, field_name.to_s.humanize, class: 'w-50 mx-1') }.join.html_safe
          = header_content

        - @value_attrs.each_with_index do |row_data, i|
          - c.row do
            - row_options = { class: 'd-flex my-1 align-items-center' }
            - row_options[:data] = { controller: 'apikey-validator', 'apikey-validator-url-value': admin_validate_apikey_catalog_configuration_path } if is_federated
            = content_tag(:div, row_options) do
              - @field_names.map do |field_name|
                - is_readonly_field = %w[name ui color].include?(field_name.to_s)
                - field_data = is_federated && field_name.to_s == 'api' ? { 'apikey-validator-target': 'api' } : (is_federated && field_name.to_s == 'apikey' ? { 'apikey-validator-target': 'apikey', action: 'input->apikey-validator#validate' } : nil)
                - content_tag(:div, class: 'w-50 mx-1 d-flex align-items-center') do
                  = text_input(label: '', name: "config[#{@key}][][#{field_name}]", value: row_data.send(field_name), error_message: '', readonly: is_readonly_field, data: field_data)
                  - if is_federated && field_name.to_s == 'apikey'
                    %span.apikey-validation-status.ml-1{style: 'display: inline-flex; align-items: center;'}
                      %span{data: { 'apikey-validator-target': 'checkingIcon' }, style: 'display: none;'}
                        = render LoaderComponent.new(small: true)
                      %span{data: { 'apikey-validator-target': 'validIcon' }, title: 'Valid API key', style: 'display: none;'}
                        = inline_svg_tag 'icons/success-icon.svg', width: '20', height: '20'
                      %span{data: { 'apikey-validator-target': 'invalidIcon' }, title: 'Invalid API key', style: 'display: none;'}
                        = inline_svg_tag 'icons/error-icon.svg', width: '20', height: '20'
              - end.join.html_safe

        - unless is_federated
          - c.template do
            = content_tag(:div, class: 'd-flex my-1') do
              - @field_names.map do |field_name|
                - content_tag(:div, class: 'w-50 mx-1') do
                  = text_input(label: '', name: "config[#{@key}][][#{field_name}]", value: "", placeholder: "#{field_name.to_s.humanize}")
              - end.join.html_safe

      %div.mt-2{style: 'display: flex; justify-content: flex-end;'}
        %button.btn.btn-secondary{ type: "button", "data-action": "turbo-modal#hide" }
          = "Cancel"
        .mx-2
          = form_save_button
