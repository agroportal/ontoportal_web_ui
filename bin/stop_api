#!/usr/bin/env bash
# Remove the API stack booted by bin/run_api: containers and data volumes.

set -euo pipefail

cd "$(dirname "$0")/.."

readonly CLONE_DIR="tmp/ontoportal_docker"

# Clones older than ontoportal_docker@main have no docker-compose.yml: compose
# would climb up to this repo's file and wipe the UI volumes instead
if [ ! -f "$CLONE_DIR/docker-compose.yml" ]; then
  echo "No ontoportal_docker@main clone in $CLONE_DIR; run bin/run_api first."
  exit 0
fi

cd "$CLONE_DIR"
./ontoportal clean -f
